{
  "name": "@pro-vision/eslint-config-pv",
  "version": "6.0.0",
  "description": "pro!vision ESLint configuration. Can be adapted and adjusted in each project.",
  "author": {
    "name": "pro!vision GmbH",
    "url": "http://www.pro-vision.de"
  },
  "contributors": [
    {
      "name": "Mehran Behzad",
      "email": "mbehzad@pro-vision.de"
    },
    {
      "name": "Ingo Fahrentholz",
      "email": "ifahrentholz@pro-vision.de"
    },
    {
      "name": "David Ding",
      "email": "dding@pro-vision.de"
    }
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-lint-recommended"
    ]
  },
  "preferGlobal": false,
  "homepage": "https://github.com/pro-vision/eslint-config-pv",
  "bugs": {
    "url": "https://github.com/pro-vision/eslint-config-pv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pro-vision/eslint-config-pv.git"
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "release": "npmpub",
    "test": "jest",
    "watch": "jest --watch"
  },
  "main": "javascript.js",
  "exports": {
    ".": "./javascript.js",
    "./javascript": "./javascript.js",
    "./typescript": "./typescript.js",
    "./prettier": "./prettier.js",
    "./configs/": "./configs/",
    "./package.json": "./package.json"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "pro!vision"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsdoc": "65.4.12",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "typescript-eslint": "8.73.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jest": "30.5.2",
    "jest-light-runner": "^0.8.2",
    "npmpub": "^6.1.1",
    "prettier": "3.10.1",
    "typescript": "~6.0.3"
  }
}
