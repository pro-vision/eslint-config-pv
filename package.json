{
  "name": "@pro-vision/eslint-config-pv",
  "version": "5.0.0-alpha.0",
  "description": "pro!vision ESLint configuration. Can be adapted and adjusted in each project.",
  "author": {
    "name": "pro!vision GmbH",
    "url": "http://www.pro-vision.de"
  },
  "contributors": [
    {
      "name": "Mehran Behzad",
      "email": "mbehzad@pro-vision.de"
    },
    {
      "name": "Ingo Fahrentholz",
      "email": "ifahrentholz@pro-vision.de"
    },
    {
      "name": "David Ding",
      "email": "dding@pro-vision.de"
    }
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-lint-recommended"
    ]
  },
  "preferGlobal": false,
  "homepage": "https://github.com/pro-vision/eslint-config-pv",
  "bugs": {
    "url": "https://github.com/pro-vision/eslint-config-pv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pro-vision/eslint-config-pv.git"
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "release": "npmpub",
    "test": "jest",
    "eslint-check": "eslint --print-config .eslintrc.js | eslint-config-prettier-check",
    "watch": "jest --watch"
  },
  "main": "javascript.js",
  "exports": {
    ".": "./javascript.js",
    "./javascript": "./javascript.js",
    "./typescript": "./typescript.js",
    "./prettier": "./prettier.js",
    "./configs/": "./configs/",
    "./package.json": "./package.json"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "pro!vision"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@eslint/js": "9.30.1",
    "@stylistic/eslint-plugin": "5.1.0",
    "eslint": "9.30.1",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "51.3.3",
    "eslint-plugin-prettier": "5.5.1",
    "globals": "16.3.0",
    "typescript-eslint": "8.35.1"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3"
  }
}
